{
  "name": "bun_elysia",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "^1.1.5",
    "bullmq": "^5.34.3",
    "drizzle-kit": "^0.28.1",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.1.28",
    "elysia-rate-limit": "^4.5.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "build": "bun build server.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun src/config/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "queue:worker": "bun src/queues/worker.ts",
    "typecheck": "tsc --noEmit"
  }
}
